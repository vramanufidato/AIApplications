# ---------------------------------------------------------------------------
# autoclaw-telegram-persona-poc — environment template
# Copy to ".env" and fill in. ".env" is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather (/newbot). Required only to actually run
# the bot against Telegram. Leave blank to use the offline mock demo.
TELEGRAM_BOT_TOKEN=

# Which brain answers: "mock" (offline, deterministic, no network) or "openai"
# (any OpenAI-compatible /v1/chat/completions endpoint, e.g. a local gateway).
LLM_PROVIDER=mock

# Used only when LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Default persona for a new chat: psychologist | astrologer
DEFAULT_PERSONA=psychologist
