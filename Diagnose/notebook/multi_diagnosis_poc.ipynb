# Unified Health Diagnosis POC
# Simulates multi-category diagnosis using standard + synthetic datasets

import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, f1_score, roc_auc_score
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense, Conv2D, Flatten

# --- Diabetes (Pima Indians) ---
from sklearn.datasets import load_diabetes
diabetes = load_diabetes()
X_d, y_d = diabetes.data, (diabetes.target > diabetes.target.mean()).astype(int)
X_train_d, X_test_d, y_train_d, y_test_d = train_test_split(X_d, y_d, test_size=0.2)

scaler = StandardScaler()
X_train_d = scaler.fit_transform(X_train_d)
X_test_d = scaler.transform(X_test_d)

diabetes_model = LogisticRegression()
diabetes_model.fit(X_train_d, y_train_d)
y_pred_d = diabetes_model.predict(X_test_d)

print("Diabetes Accuracy:", accuracy_score(y_test_d, y_pred_d))

# --- Cancer (Wisconsin Breast Cancer) ---
from sklearn.datasets import load_breast_cancer
cancer = load_breast_cancer()
X_c, y_c = cancer.data, cancer.target
X_train_c, X_test_c, y_train_c, y_test_c = train_test_split(X_c, y_c, test_size=0.2)

cancer_model = RandomForestClassifier()
cancer_model.fit(X_train_c, y_train_c)
y_pred_c = cancer_model.predict(X_test_c)

print("Cancer F1:", f1_score(y_test_c, y_pred_c))

# --- Mental Health (Synthetic) ---
np.random.seed(42)
X_m = np.random.rand(500, 10)
y_m = np.random.randint(0, 2, 500)
X_train_m, X_test_m, y_train_m, y_test_m = train_test_split(X_m, y_m, test_size=0.2)

mental_model = LogisticRegression()
mental_model.fit(X_train_m, y_train_m)
y_pred_m = mental_model.predict(X_test_m)

print("Mental Health Accuracy:", accuracy_score(y_test_m, y_pred_m))

# --- Vision (Synthetic CNN) ---
X_v = np.random.rand(200, 28, 28, 1)
y_v = np.random.randint(0, 2, 200)
X_train_v, X_test_v, y_train_v, y_test_v = train_test_split(X_v, y_v, test_size=0.2)

vision_model = Sequential([
    Conv2D(16, (3,3), activation='relu', input_shape=(28,28,1)),
    Flatten(),
    Dense(32, activation='relu'),
    Dense(1, activation='sigmoid')
])
vision_model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])
vision_model.fit(X_train_v, y_train_v, epochs=3, verbose=0)

loss, acc = vision_model.evaluate(X_test_v, y_test_v, verbose=0)
print("Vision Accuracy:", acc)

# --- Unified Risk Profile ---
def unified_risk(diabetes_pred, cancer_pred, mental_pred, vision_pred):
    return np.mean([diabetes_pred, cancer_pred, mental_pred, vision_pred])

risk_score = unified_risk(np.mean(y_pred_d), np.mean(y_pred_c), np.mean(y_pred_m), np.mean(y_test_v))
print("Unified Risk Score:", risk_score)
